# Copy to .env.local and fill in from your Supabase project (Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Set to "true" once an SMS provider (e.g. Twilio) is configured in Supabase Auth.
NEXT_PUBLIC_PHONE_AUTH_ENABLED=false

# Voice and video calls (https://cloud.livekit.io: Settings > Keys). Keep the secret server-side.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
